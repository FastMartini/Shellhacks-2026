# Copy to backend/.env and fill in. Never commit .env.

# Alpaca market data (free tier): https://app.alpaca.markets → API keys
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Finnhub company news (free tier): https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Solana devnet RPC. The public URL works but rate-limits; for the demo use the team's Helius devnet URL
# (https://dashboard.helius.dev → free plan), which looks like https://devnet.helius-rpc.com/?api-key=<key>.
# Put the same URL in frontend/.env as VITE_SOLANA_RPC_URL. Don't leave this blank: a blank value overrides the default.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Vault keypair (mint authority and fee payer). Defaults to backend/keys/vault-keypair.json, which
# scripts/setup_devnet.py writes; get the shared file from the team channel. Uncomment only to point elsewhere.
# VAULT_KEYPAIR=/absolute/path/to/vault-keypair.json
